# ─── Cardano Network ────────────────────────────────────────────────
NETWORK=preprod
# Blockfrost preprod project id — Python side only. Consumed by:
#   - services/charli3-bridge/ (FastAPI bridge)
#   - services/supplier-erp-mock/ (ERP mocks)
#   - docker-compose.yml (9 node containers + bridge + ERPs — compose reads
#     .env directly, so the variable must live here)
#   - all Python deploy scripts under scripts/
#   - Charli3 SDK (token_finder, tx builder)
#
# Node/CAP side (ODATANO) does NOT read this. Set the Blockfrost key for
# ODATANO in apps/cap/package.json → cds.requires.odatano-core.blockfrostApiKey
# as a literal value. That is the most reliable path: @sap/cds does not expand
# ${} in custom config fields, so keep it as a plain string there.
BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here

# ─── ODATANO (published as @odatano/core) ───────────────────────────
# All consumer config (backends, txBuilders, network, blockfrostApiKey,
# timeouts, indexTtlMs) lives in apps/cap/package.json under
# cds.requires.odatano-core. Env-var overrides (TX_BUILDERS, BACKENDS, …)
# only apply to standalone mode, which we don't use — nothing in this repo
# reads them.

# ─── Charli3 Bridge ─────────────────────────────────────────────────
BRIDGE_PORT=8000
BRIDGE_URL=http://localhost:8000

# Bridge needs policy_id → oracle_address mapping to look up AggState UTxOs
# on-chain. Format: <policy_id>:<bech32_addr>,<policy_id>:<bech32_addr>,...
# One entry per supplier (D-05: one policy per supplier, feeds distinguished
# by asset_name C3AS_inventory / C3AS_price).
ORACLE_ADDRESSES=

# Bridge ODV orchestrator (D-05): comma-separated node HTTP URLs the bridge
# fans /odv/feed/{feed_id} out to. Must be our forked node image that
# exposes /odv/feed/{feed_id} and /odv/sign/{feed_id} per-feed endpoints.
# Example for Supplier-A: http://node-a-1:8000,http://node-a-2:8000,http://node-a-3:8000
NODE_URLS=

# Designated coordinator node URL. When set, bridge proxies /odv-update to
# {COORDINATOR_URL}/odv/aggregate/{feed_id} with the remaining NODE_URLS as
# peer_urls. Leave unset for collector-only mode (gathers signed messages
# but doesn't submit).
COORDINATOR_URL=

# Validity window sent to each node's /feed request (ms around now).
ORCHESTRATOR_VALIDITY_WINDOW_MS=120000

# Minimum node responses required before the bridge considers the ODV
# round collected. Leave unset to require all NODE_URLS to respond.
ORCHESTRATOR_THRESHOLD=

# ─── Charli3 Reference Script (shared across all oracles) ───────────
# Populated once after first deploy_settings call.
REF_SCRIPT_ADDR=
REF_SCRIPT_TX_HASH_A_INV=
REF_SCRIPT_TX_HASH_A_PRICE=
REF_SCRIPT_TX_HASH_B_INV=
REF_SCRIPT_TX_HASH_B_PRICE=
REF_SCRIPT_TX_HASH_C_INV=
REF_SCRIPT_TX_HASH_C_PRICE=

# ─── Plan B: 2 Oracles per Supplier (Inventory + Price) ─────────────
# Filled by the oracle deploy scripts. See services/charli3-fork/configs/README.md.

# Supplier A
INVENTORY_POLICY_ID_SUPPLIER_A=
INVENTORY_ORACLE_ADDR_SUPPLIER_A=
PRICE_POLICY_ID_SUPPLIER_A=
PRICE_ORACLE_ADDR_SUPPLIER_A=

# Supplier B
INVENTORY_POLICY_ID_SUPPLIER_B=
INVENTORY_ORACLE_ADDR_SUPPLIER_B=
PRICE_POLICY_ID_SUPPLIER_B=
PRICE_ORACLE_ADDR_SUPPLIER_B=

# Supplier C
INVENTORY_POLICY_ID_SUPPLIER_C=
INVENTORY_ORACLE_ADDR_SUPPLIER_C=
PRICE_POLICY_ID_SUPPLIER_C=
PRICE_ORACLE_ADDR_SUPPLIER_C=

# ─── Node Mnemonics (one per node, shared across both feeds) ────────
# Each supplier has 3 nodes; same 3 mnemonics sign for inventory + price.
# 24-word mnemonic, space-separated.
MNEMONIC_A_1=
MNEMONIC_A_2=
MNEMONIC_A_3=
MNEMONIC_B_1=
MNEMONIC_B_2=
MNEMONIC_B_3=
MNEMONIC_C_1=
MNEMONIC_C_2=
MNEMONIC_C_3=

# ─── Coordinator Node Keys ─────────────────────────────────────────────
# The designated coordinator node runs with COORDINATOR_KEYS_DIR pointing
# at a directory containing peer .skey files. On /odv/aggregate, it loads
# all *.skey in that dir and signs the aggregation Tx with them alongside
# its own feed key — satisfies the validator's threshold check without
# distributed sign-exchange over HTTP. Mount via docker-compose volume.
COORDINATOR_KEYS_DIR=

# ─── ERP Mock Endpoints ─────────────────────────────────────────────
ERP_A_URL=http://localhost:8001
ERP_B_URL=http://localhost:8002
ERP_C_URL=http://localhost:8003

# ─── Supplier Payment Addresses (Bech32) ────────────────────────────
SUPPLIER_A_PAYMENT_ADDR=
SUPPLIER_B_PAYMENT_ADDR=
SUPPLIER_C_PAYMENT_ADDR=

# ─── Order Mint Validator ───────────────────────────────────────────
# Optional override for the unapplied CBOR hex of the Aiken order_mint
# validator. Consumed by getOrderMintValidatorCbor() in
# @c3-supply/contracts-ts. Resolution order:
#   1. ORDER_MINT_VALIDATOR_CBOR env var (this)
#   2. packages/contracts-ts/src/order_mint.plutus.json (aiken blueprint)
# Regenerate the blueprint after contract changes with `aiken build`
# in contracts/aiken, then copy plutus.json to the path above.
ORDER_MINT_VALIDATOR_CBOR=

# Per-supplier deployed mint-policy IDs. Populated by
# scripts/deploy-order-mint-refscript.py after a successful preprod deploy.
# CAP's orders-service looks these up at buy time via deriveMintPolicyId().
ORDER_MINT_POLICY_SUPPLIER_A=
ORDER_MINT_POLICY_SUPPLIER_B=
ORDER_MINT_POLICY_SUPPLIER_C=

# ─── Ogmios ─────────────────────────────────────────────────────────
# Required for ODV rounds to work. Every forked Charli3 oracle node loads
# a monkey-patch at node/__init__.py:63-171 that routes pycardano's
# evaluate_tx_cbor through Ogmios v6 JSON-RPC. Two reasons this is not
# optional:
#   1. Blockfrost's /utils/txs/evaluate collapses empty ScriptFailures into
#      Namespace(), hiding real Plutus errors and failing valid txs.
#   2. Tx-chaining: aggregate Txs that spend a not-yet-confirmed C3RA
#      output need the chained UTxO forwarded as Ogmios `additionalUtxo`
#      for script-context resolution.
# scripts/odv-first-round.py uses the same endpoint for the same reason.
# Point this at a reachable Ogmios v6 instance on the target network.
OGMIOS_URL=http://ogmios-host:1337

# ─── CAP ────────────────────────────────────────────────────────────
CAP_PORT=4004
