# ─── Charli3 forks — per-repo junk ──────────────────────────────────
# Poetry / pip install outputs (each fork has its own .venv when developed
# locally; rebuilt via `poetry install`). Egg-info and pycache excluded above.
services/charli3-fork/*/.venv/
services/charli3-fork/*/.pytest_cache/
services/charli3-fork/*/dist/
services/charli3-fork/*/artifacts/

